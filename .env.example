# Bridge Service Configuration
PORT=3003
NODE_ENV=development

# Private key of one of the Safe owners
# This is used to propose transactions to the Safe
ETH_PRIVATE_KEY=0x...

# Optional: Override default RPC endpoints
# BASE_RPC=https://your-base-rpc.example.com
# POLYGON_RPC=https://your-polygon-rpc.example.com
# ARBITRUM_RPC=https://your-arbitrum-rpc.example.com
# AVALANCHE_RPC=https://your-avalanche-rpc.example.com
# BSC_RPC=https://your-bsc-rpc.example.com